# Dependencies
node_modules/

# Build output — regenerate with `npm run build`
dist/
*.local

# Editor / OS cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# Vite
.vite/

# Claude Code — machine-local permissions, not shared
.claude/settings.local.json

# Licensed typeface — not redistributable. See public/fonts/README.md
public/fonts/*
!public/fonts/README.md

# Generated design file — embeds the licensed typeface, so it stays local.
# Rebuild with: node tools/build-design-file.mjs
design/

# Blender output — proof renders and the saved scene both embed the licensed
# typeface, and they are regenerated in one command, so they stay local.
# Rebuild with: blender -b -P blender/render.py -- --out renders
renders/
*.blend1

# Python bytecode
__pycache__/
*.py[cod]
